# Variables d'environnement
# Copiez ce fichier en .env et adaptez les valeurs

# Port du serveur
PORT=5000

# MongoDB (décommentez et configurez quand vous connectez la BD)
# MONGODB_URI=mongodb://localhost:27017/maisonseason
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/maisonseason

# JWT Secret (changez cette valeur en production !)
JWT_SECRET=votre_secret_jwt_a_changer_en_production

# Node environment
NODE_ENV=development
